<Window
    x:Class="LoomEditor.Gallery.HostApiDemoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loom="using:LoomEditor.WinUI.Controls"
    Title="LoomEditor Gallery - Host API">

    <!-- Phase 13: a host application's view of the editor (public API only). Buttons on top, blame column + editor, event log at the bottom. -->
    <Grid RowDefinitions="Auto,Auto,*,160">
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Margin="12,8,12,0" Spacing="8">
                <Button Click="OnConflictColors" Content="Conflict colors" />
                <Button Click="OnClearDecorations" Content="Clear decorations" />
                <Button Click="OnHideUnchanged" Content="Hide unchanged" />
                <Button Click="OnShowAll" Content="Show all" />
                <Button Click="OnAddConflictHeader" Content="Add conflict header" />
                <Button Click="OnAddTextBoxZone" Content="Add text box zone" />
                <Button Click="OnRemoveZones" Content="Remove zones" />
                <Button Click="OnReloadSameText" Content="Reload same text" />
                <CheckBox x:Name="LineNumbersBox" IsChecked="True" Click="OnLineNumbersChanged" Content="Line numbers" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,4,12,8" Spacing="8">
            <TextBlock VerticalAlignment="Center" Text="File name" />
            <TextBox x:Name="FileNameBox" Width="200" Text="Conflicts.cs" />
            <Button Click="OnApplyLanguage" Content="Apply language" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="220,*">
            <Canvas x:Name="BlameCanvas" Grid.Column="0" Width="220" />
            <loom:LoomEditor x:Name="Editor" Grid.Column="1" />
        </Grid>

        <ListView x:Name="LogList" Grid.Row="3" SelectionMode="None" />
    </Grid>
</Window>
