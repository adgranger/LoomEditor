<Window
    x:Class="LoomEditor.Gallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loom="using:LoomEditor.WinUI.Controls"
    Title="LoomEditor Gallery">

    <Grid RowDefinitions="Auto,*">
        <TextBlock
            Margin="12,8"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="LoomEditor — phase 0: static text, line numbers, Ctrl+A selects all" />
        <loom:LoomEditor x:Name="Editor" Grid.Row="1" />
    </Grid>
</Window>
