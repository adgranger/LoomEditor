<Window
    x:Class="LoomEditor.Gallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loom="using:LoomEditor.WinUI.Controls"
    Title="LoomEditor Gallery">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock
            Margin="12,8"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="LoomEditor — phase 7: accessibility" />
        <StackPanel Grid.Row="1" Margin="12,0,12,8" Orientation="Horizontal" Spacing="8">
            <Button Click="OnInsertHeader" Content="Insert header" />
            <Button Click="OnAppendLine" Content="Append line" />
            <Button Click="OnDeleteFirstLine" Content="Delete first line" />
            <Button Click="OnReplaceHello" Content="Replace &quot;Hello&quot;" />
            <Button x:Name="UndoButton" Click="OnUndo" Content="Undo" />
            <Button x:Name="RedoButton" Click="OnRedo" Content="Redo" />
            <Button Click="OnLf" Content="LF" />
            <Button Click="OnCrlf" Content="CRLF" />
            <Button Click="OnReset" Content="Reset" />
            <ToggleSwitch x:Name="SmoothScrollingSwitch" Toggled="OnSmoothScrollingToggled" OffContent="Smooth scrolling" OnContent="Smooth scrolling" />
            <ToggleSwitch x:Name="WordWrapSwitch" Toggled="OnWordWrapToggled" OffContent="Word wrap" OnContent="Word wrap" />
            <ToggleSwitch x:Name="MinimapSwitch" IsOn="True" Toggled="OnMinimapToggled" OffContent="Minimap" OnContent="Minimap" />
            <ToggleSwitch x:Name="StickyScrollSwitch" IsOn="True" Toggled="OnStickyScrollToggled" OffContent="Sticky scroll" OnContent="Sticky scroll" />
            <ToggleSwitch x:Name="ReadOnlySwitch" Toggled="OnReadOnlyToggled" OffContent="Read-only" OnContent="Read-only" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="12,0,12,8" Orientation="Horizontal" Spacing="8">
            <NumberBox x:Name="FontSizeBox" Header="Font size" Minimum="8" Maximum="40" SpinButtonPlacementMode="Inline" Value="14" ValueChanged="OnFontSizeChanged" />
            <ComboBox x:Name="GuidesBox" Header="Guides" SelectedIndex="0" SelectionChanged="OnGuidesChanged">
                <ComboBoxItem Content="Indent only" />
                <ComboBoxItem Content="Indent + bracket pairs" />
                <ComboBoxItem Content="None" />
            </ComboBox>
            <ComboBox x:Name="FontFamilyBox" Header="Font family" SelectedIndex="0" SelectionChanged="OnFontFamilyChanged">
                <ComboBoxItem Content="Cascadia Mono" />
                <ComboBoxItem Content="Consolas" />
                <ComboBoxItem Content="Segoe UI" />
            </ComboBox>
            <NumberBox x:Name="TabSizeBox" Header="Tab size" Minimum="1" Maximum="16" SpinButtonPlacementMode="Inline" Value="4" ValueChanged="OnTabSizeChanged" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="12,0,12,8" Orientation="Horizontal" Spacing="8">
            <Button x:Name="LargeFileButton" Click="OnLargeFile" Content="Large file (100 MB)" />
            <Button x:Name="LongLineButton" Click="OnLongLine" Content="Long line (1 MB)" />
            <Button x:Name="UnicodeButton" Click="OnUnicode" Content="Unicode sample" />
            <Button x:Name="ScrollTestButton" Click="OnScrollTest" Content="Scroll test" />
            <Button Click="OnInjectText" Content="Inject text" />
            <Button Click="OnClearInjectedText" Content="Clear injected text" />
            <Button x:Name="MultiCursorButton" Click="OnMultiCursorSample" Content="Sample: multi-cursor" />
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="12,0,12,8" Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="LanguageBox" Header="Language" SelectedIndex="0" SelectionChanged="OnLanguageChanged" />
            <ComboBox x:Name="ThemeBox" Header="Theme" SelectedIndex="0" SelectionChanged="OnThemeChanged" />
            <Button x:Name="LargeCSharpButton" Click="OnLargeCSharp" Content="Large C# (20 000 lines)" VerticalAlignment="Bottom" />
            <ComboBox x:Name="FeatureSampleBox" Header="Features" MinWidth="220" SelectionChanged="OnFeatureSampleChanged" />
            <TextBlock x:Name="FeatureHintText" VerticalAlignment="Bottom" Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>
        <StackPanel Grid.Row="5" Margin="12,0,12,8" Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="ScreenReaderBox" Header="Screen reader mode" SelectedIndex="0" SelectionChanged="OnScreenReaderChanged">
                <ComboBoxItem Content="Auto" />
                <ComboBoxItem Content="On" />
                <ComboBoxItem Content="Off" />
            </ComboBox>
            <ToggleSwitch x:Name="TabFocusSwitch" Toggled="OnTabFocusToggled" OffContent="Tab moves focus" OnContent="Tab moves focus" />
            <ToggleSwitch x:Name="SystemHighContrastSwitch" IsOn="True" Toggled="OnSystemHighContrastToggled" OffContent="Follow system high contrast" OnContent="Follow system high contrast" />
            <Button Click="OnLongLineSample" Content="Long-line sample" VerticalAlignment="Bottom" />
            <Button Click="OnUiaSelfCheck" Content="UIA self-check" VerticalAlignment="Bottom" />
        </StackPanel>
        <Grid Grid.Row="6" RowDefinitions="*,Auto">
            <loom:LoomEditor x:Name="Editor" />
            <ScrollViewer Grid.Row="1" MaxHeight="160" Visibility="Collapsed" x:Name="SelfCheckScroll">
                <TextBlock x:Name="SelfCheckText" Margin="12,4" FontFamily="Cascadia Mono" FontSize="12" IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="7" Margin="12,6" Style="{StaticResource CaptionTextBlockStyle}" />
    </Grid>
</Window>
