<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Performance benchmarks (BenchmarkDotNet). Not run by `dotnet test`.
    Run: see docs/performance.md ("How to run the benchmarks").
    Reference results are kept in docs/performance.md.
  -->
  <PropertyGroup>
    <TargetFramework>$(LoomNetTargetFramework)</TargetFramework>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LoomEditor.Core\LoomEditor.Core.csproj" />
    <ProjectReference Include="..\..\src\LoomEditor.View\LoomEditor.View.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The golden samples (not their token files) are the text the tokenization benchmarks read. -->
    <None Include="..\LoomEditor.TextMate.Tests\Golden\**\sample.*" Exclude="..\LoomEditor.TextMate.Tests\Golden\**\*.tokens.json" LinkBase="Golden" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="LoomEditor.Core.Text.Range" Alias="Range" />
  </ItemGroup>
</Project>
