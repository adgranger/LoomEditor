<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(LoomNetTargetFramework)</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LoomEditor.View\LoomEditor.View.csproj" />
    <ProjectReference Include="..\..\src\LoomEditor.Lsp\LoomEditor.Lsp.csproj" />
    <!-- A normal reference: the fake server's assembly is copied next to the tests. -->
    <ProjectReference Include="..\LoomEditor.Lsp.FakeServer\LoomEditor.Lsp.FakeServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\LoomEditor.Core.Tests\Languages\TestHelpers\**\*.cs" Link="Languages\TestHelpers\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The helpers of the LSP tests (fake server host, locator); their own tests stay in LoomEditor.Lsp.Tests. -->
    <Compile Include="..\LoomEditor.Lsp.Tests\TestHelpers\**\*.cs" Exclude="..\LoomEditor.Lsp.Tests\TestHelpers\MemoryPipeTests.cs" Link="Lsp\TestHelpers\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="LoomEditor.Core.Text.Range" Alias="Range" />
  </ItemGroup>
</Project>
