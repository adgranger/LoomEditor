    <ProjectReference Include="..\..\src\LoomEditor.Themes\LoomEditor.Themes.csproj" />
    <ProjectReference Include="..\..\src\LoomEditor.View\LoomEditor.View.csproj" />
    <ProjectReference Include="..\..\src\LoomEditor.Lsp\LoomEditor.Lsp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
