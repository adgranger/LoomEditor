<Project Sdk="Microsoft.NET.Sdk">
  <!-- Phase 4: golden tests (sample file + expected tokens) live in Golden/. See docs/how-to/add-a-language.md. -->
  <PropertyGroup>
    <TargetFramework>$(LoomNetTargetFramework)</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LoomEditor.TextMate\LoomEditor.TextMate.csproj" />
    <ProjectReference Include="..\..\src\LoomEditor.Themes\LoomEditor.Themes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- vscode-textmate test cases (MIT), copied byte for byte; found at run time by TestHelpers/TestCaseFiles.cs. -->
    <None Update="TestCases\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
