<Project Sdk="Microsoft.NET.Sdk">
  <!--
    LoomEditor.View: everything the editor does that is not pixels — cursors, commands, layout, features.
    RULE: no UI framework. Testable with plain `dotnet test`.
  -->
  <PropertyGroup>
    <TargetFramework>$(LoomNetTargetFramework)</TargetFramework>
    <RootNamespace>LoomEditor.View</RootNamespace>
    <Description>Editor logic of LoomEditor (cursors, commands, layout, features), independent of any UI framework.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="LoomEditor.Core.Text.Range" Alias="Range" />
  </ItemGroup>

  <ItemGroup>
    <!-- The layers above View share its internals (ADR 0005). -->
    <InternalsVisibleTo Include="LoomEditor.Rendering" />
    <InternalsVisibleTo Include="LoomEditor.WinUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LoomEditor.Core\LoomEditor.Core.csproj" />
    <ProjectReference Include="..\LoomEditor.TextMate\LoomEditor.TextMate.csproj" />
    <ProjectReference Include="..\LoomEditor.Themes\LoomEditor.Themes.csproj" />
  </ItemGroup>
</Project>
