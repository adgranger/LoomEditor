<Project Sdk="Microsoft.NET.Sdk">
  <!--
    LoomEditor.TextMate: TextMate grammars (the syntax-highlighting format of VS Code) and the Oniguruma regex engine.
    RULE: references LoomEditor.Core only. Native code is reached through [LibraryImport] in Oniguruma/ only.
  -->
  <PropertyGroup>
    <TargetFramework>$(LoomNetTargetFramework)</TargetFramework>
    <RootNamespace>LoomEditor.TextMate</RootNamespace>
    <Description>TextMate grammar tokenizer for LoomEditor (port of vscode-textmate), backed by Oniguruma.</Description>
    <!-- [LibraryImport] in Oniguruma/ passes pinned strings as pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- LoomEditor.TextMate.Tests is added by src/Directory.Build.props. -->
    <InternalsVisibleTo Include="LoomEditor.View" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LoomEditor.Core\LoomEditor.Core.csproj" />
  </ItemGroup>

  <!-- Builds (when missing), copies and packs onig.dll. -->
  <Import Project="..\native\oniguruma\Oniguruma.targets" />
</Project>
