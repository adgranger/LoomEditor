<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LoomEditor.WinUI.Controls"
    xmlns:diff="using:LoomEditor.WinUI.Controls.DiffEditor"
    xmlns:find="using:LoomEditor.WinUI.Controls.Find"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml">

    <!-- Default look of the LoomEditor control. PART_Canvas is required: all text is drawn on it. -->
    <Style TargetType="controls:LoomEditor">
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:LoomEditor">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <win2d:CanvasControl x:Name="PART_Canvas" />
                            <find:FindWidget
                                x:Name="PART_FindWidget"
                                Margin="0,0,14,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Visibility="Collapsed" />
                            <Canvas x:Name="PART_OverlayCanvas" />
                            <ScrollBar
                                x:Name="PART_VerticalScrollBar"
                                HorizontalAlignment="Right"
                                IndicatorMode="MouseIndicator"
                                Orientation="Vertical"
                                Visibility="Collapsed" />
                            <ScrollBar
                                x:Name="PART_HorizontalScrollBar"
                                VerticalAlignment="Bottom"
                                IndicatorMode="MouseIndicator"
                                Orientation="Horizontal"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default look of the LoomDiffEditor control: the three parts are required and placed by code (sash position, inline mode). -->
    <Style TargetType="controls:LoomDiffEditor">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:LoomDiffEditor">
                    <Grid Background="{TemplateBinding Background}">
                        <controls:LoomEditor x:Name="PART_Original" HorizontalAlignment="Left" />
                        <controls:LoomEditor x:Name="PART_Modified" HorizontalAlignment="Stretch" />
                        <diff:DiffEditorSash x:Name="PART_Sash" HorizontalAlignment="Left" />
                        <diff:DiffOverviewRuler x:Name="PART_Overview" />
                        <Grid x:Name="PART_ViewerHost" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
