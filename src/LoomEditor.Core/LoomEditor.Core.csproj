<Project Sdk="Microsoft.NET.Sdk">
  <!--
    LoomEditor.Core: text model and value types (Position, Range, Selection, TextEdit).
    RULE: no UI, no Windows, no project references. Testable with plain `dotnet test`.
  -->
  <PropertyGroup>
    <TargetFramework>$(LoomNetTargetFramework)</TargetFramework>
    <RootNamespace>LoomEditor.Core</RootNamespace>
    <Description>Platform-independent text model of LoomEditor (a native port of the Monaco editor).</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- The cursor (LoomEditor.View) uses the internal members of the model: tracked ranges, strings, columns, words. -->
    <InternalsVisibleTo Include="LoomEditor.View" />
    <!-- The TextMate tokenization support implements Core's ITokenizationSupport / IState. -->
    <InternalsVisibleTo Include="LoomEditor.TextMate" />
    <InternalsVisibleTo Include="LoomEditor.TextMate.Tests" />
    <InternalsVisibleTo Include="LoomEditor.View.Tests" />
    <!-- The renderer reads token metadata (font styles, color ids); the control gives the model a UI dispatcher. -->
    <InternalsVisibleTo Include="LoomEditor.Rendering" />
    <InternalsVisibleTo Include="LoomEditor.Rendering.Tests" />
    <InternalsVisibleTo Include="LoomEditor.WinUI" />
    <!-- The Gallery demo adds an injected text decoration (ModelDecorationOptions, InjectedTextOptions). -->
    <InternalsVisibleTo Include="LoomEditor.Gallery" />
  </ItemGroup>
</Project>
