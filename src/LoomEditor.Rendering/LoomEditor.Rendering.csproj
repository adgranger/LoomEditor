<Project Sdk="Microsoft.NET.Sdk">
  <!--
    LoomEditor.Rendering: turns the view (LoomEditor.View) into pixels.
    Portable (net11.0): it only talks to IRenderSurface. Backends live in the control projects
    (Win2D in LoomEditor.WinUI). See docs/adr/0002-rendering-backend.md and docs/adr/0016-avalonia-backend.md.
  -->
  <PropertyGroup>
    <TargetFramework>$(LoomNetTargetFramework)</TargetFramework>
    <RootNamespace>LoomEditor.Rendering</RootNamespace>
    <Description>Rendering of LoomEditor: what to draw, behind IRenderSurface.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The control shares the internals of Rendering (ADR 0005). -->
    <InternalsVisibleTo Include="LoomEditor.WinUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LoomEditor.View\LoomEditor.View.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- LoomEditor.Core.Text.Range wins over System.Range. See docs/adr/0003-naming-and-namespaces.md. -->
    <Using Include="LoomEditor.Core.Text.Range" Alias="Range" />
  </ItemGroup>
</Project>
