<Project Sdk="Microsoft.NET.Sdk">
  <!--
    LoomEditor.Rendering: turns the view (LoomEditor.View) into pixels.
    Everything outside Win2D/ only talks to IRenderSurface, never to Win2D or DirectWrite directly.
    See docs/adr/0002-rendering-backend.md.
  -->
  <PropertyGroup>
    <TargetFramework>$(LoomWindowsTargetFramework)</TargetFramework>
    <TargetPlatformMinVersion>$(LoomWindowsMinVersion)</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <RootNamespace>LoomEditor.Rendering</RootNamespace>
    <Description>Rendering of LoomEditor with Win2D (Direct2D / DirectWrite).</Description>
    <!--
      Libraries are built AnyCPU. The native Microsoft.Graphics.Canvas.dll is copied by the *application*,
      which is always built for x64 or ARM64, so Win2D's AnyCPU warning does not apply here.
    -->
    <Win2DWarnNoPlatform>false</Win2DWarnNoPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
  </ItemGroup>

  <ItemGroup>
    <!-- The control shares the internals of Rendering (ADR 0005). -->
    <InternalsVisibleTo Include="LoomEditor.WinUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LoomEditor.View\LoomEditor.View.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- LoomEditor.Core.Text.Range wins over System.Range. See docs/adr/0003-naming-and-namespaces.md. -->
    <Using Include="LoomEditor.Core.Text.Range" Alias="Range" />
  </ItemGroup>
</Project>
