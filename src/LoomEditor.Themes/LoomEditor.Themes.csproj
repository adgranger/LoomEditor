<Project Sdk="Microsoft.NET.Sdk">
  <!--
    LoomEditor.Themes: VS Code color themes (.json) turned into a simple color model.
    RULE: no UI types. Colors are plain ThemeColor values.
  -->
  <PropertyGroup>
    <TargetFramework>$(LoomNetTargetFramework)</TargetFramework>
    <RootNamespace>LoomEditor.Themes</RootNamespace>
    <Description>Color themes for LoomEditor, compatible with VS Code themes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Themes tests live in LoomEditor.TextMate.Tests (the test project of phase 4). -->
    <InternalsVisibleTo Include="LoomEditor.TextMate.Tests" />
    <InternalsVisibleTo Include="LoomEditor.View" />
    <InternalsVisibleTo Include="LoomEditor.Rendering" />
    <InternalsVisibleTo Include="LoomEditor.WinUI" />
    <InternalsVisibleTo Include="LoomEditor.Rendering.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="BuiltIn\*.json" LogicalName="Themes/BuiltIn/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LoomEditor.Core\LoomEditor.Core.csproj" />
  </ItemGroup>
</Project>
